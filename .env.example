# ==============================================================================
# ShopSphere Global Environment Configuration Template
# Copy this file to .env or configure respective frontend/.env and backend environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot 3)
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Defaults to MySQL in production, H2 in dev profile)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security & JWT Token (Must be 256-bit / 32+ characters hex string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Default Seed Administrator Credentials (Initialized if absent)
ADMIN_EMAIL=admin@shopsphere.com
ADMIN_PASSWORD=Admin@123456

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
